    "metadata": {
      "row_count": 5,
      "column_count": 2,
      "query": "\nSELECT\n  p.name,\n  SUM(oi.quantity * oi.unit_price) AS total_sales\nFROM products AS p\nJOIN order_items AS oi\n  ON p.id = oi.product_id\nGROUP BY\n  p.name\nORDER BY\n  total_sales DESC\nLIMIT 5;\n"
    }
